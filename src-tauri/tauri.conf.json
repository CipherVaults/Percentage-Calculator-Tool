{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Percentage Calculator Tool",
  "version": "2.1.0",
  "identifier": "com.percentagecalculator.tool",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Percentage Calculator Tool",
        "width": 1120,
        "height": 860,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#0E0F12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
